SoftwareType
{
    Name            "Laptop"
    Description     "A portable computer with integrated display and battery."
    Random          0.1
    IdealPrice      500
    OptimalDevTime  60
    OneClient       False
    InHouse         False
    Popularity      1.0
    Retention       360
    Iterative       0.85
    Hardware        True
    Manufacturing
    {
        Components
        [
            { Name Plastic; BuiltInThumbnail Plastic; Price 10; Time 8 }
            { Name Metal; BuiltInThumbnail Metal; Price 20; Time 12 }
        ]
        Processes
        [
            { Inputs [ Plastic; Metal ]; Output Final }
        ]
        FinalTime       8
    }
    SubmarketNames  [ Performance; Usability; Quality ]
    NameGenerator   Hardware
    Categories
    [
        {
            Name            "Standard Laptop"
            Description     "A standard Laptop device."
            Popularity      1.0
            Retention       360
            TimeScale       1
            Iterative       0.85
            Submarkets      [ 1; 1; 1 ]
        }
    ]
    Features
    [
        {
            Name            "Device Assembly"
            Spec            Hardware
            DevTime         5
            CodeArt         1
            Submarkets      [ 1; 1; 1 ]
            Features
            [
                { Name "Required Processor (CPU)"; FrameworkRequirement "Processor (CPU)"; Level 1; DevTime 2; CodeArt 1; Submarkets [ 1; 1; 1 ] }
                { Name "Required Motherboard"; FrameworkRequirement "Motherboard"; Level 1; DevTime 2; CodeArt 1; Submarkets [ 1; 1; 1 ] }
                { Name "Required Memory (RAM)"; FrameworkRequirement "Memory (RAM)"; Level 1; DevTime 2; CodeArt 1; Submarkets [ 1; 1; 1 ] }
                { Name "Required Data Storage"; FrameworkRequirement "Data Storage"; Level 1; DevTime 2; CodeArt 1; Submarkets [ 1; 1; 1 ] }
                { Name "Required Battery"; FrameworkRequirement "Battery"; Level 1; DevTime 2; CodeArt 1; Submarkets [ 1; 1; 1 ] }
                { Name "Required Display Panel"; FrameworkRequirement "Display Panel"; Level 1; DevTime 2; CodeArt 1; Submarkets [ 1; 1; 1 ] }
                { Name "Required Device Case"; FrameworkRequirement "Device Case"; Level 1; DevTime 2; CodeArt 1; Submarkets [ 1; 1; 1 ] }
                { Name "Required Operating System"; FrameworkRequirement "Operating System"; Level 1; DevTime 2; CodeArt 1; Submarkets [ 1; 1; 1 ] }
                { Name "Optional GPU"; FrameworkRequirement "Graphics Card (GPU)"; Level 2; DevTime 3; CodeArt 1; Submarkets [ 2; 0; 0 ] }
            ]
        }
    ]
}


